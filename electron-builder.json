{
  "appId": "com.kutomi86.googleslidedownloader",
  "productName": "Google Slides Downloader",
  "copyright": "Copyright © 2026",
  "artifactName": "Google.Slides.Downloader.Setup.${version}.${ext}",
  "directories": {
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "package.json",
    "tailwind.config.js"
  ],
  "win": {
    "target": "nsis",
    "icon": "src/renderer/assets/icon.ico"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "kutomi86",
      "repo": "google-slide-downloader"
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
